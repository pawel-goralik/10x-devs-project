---
import Layout from "@/layouts/Layout.astro";
import GoalCard from "@/components/goals/GoalCard";
import { createClient } from "@/lib/supabase";
import { getGroupDetail } from "@/lib/services/groups";
import { listGroupMemberGoals } from "@/lib/services/goals";
import type { Goal } from "@/types";

const { id } = Astro.params;
const user = Astro.locals.user;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const group = id && supabase ? await getGroupDetail(supabase, id) : null;
// Accepted risk (plan review, 2026-08-31): no friendly not-found/not-a-member message —
// a non-member visiting another group's URL directly gets an ungraceful error instead.
// RLS already blocks any data exposure either way; this throw only narrows `group` to
// non-null for TypeScript.
if (!group) {
  throw new Error(`Group ${id} not found or not accessible`);
}

const inviteLink = new URL(`/groups/join/${group.inviteToken}`, Astro.url.origin).toString();

// "Witness the circle's goals" (roadmap S-03): every OTHER current member's locked goals,
// in the same order as the members list above. The viewer's own goals stay exclusive to
// /goals — see plan.md's "What We're NOT Doing".
const otherMembers = group.members.filter((member) => member.userId !== user?.id);
const goalsByMember: Map<string, Goal[]> =
  supabase && otherMembers.length > 0
    ? await listGroupMemberGoals(
        supabase,
        otherMembers.map((member) => member.userId),
      )
    : new Map<string, Goal[]>();
---

<Layout title={group.name}>
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-2xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        {group.name}
      </h1>

      <div class="mb-8 rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h2 class="mb-2 text-lg font-semibold">Link z zaproszeniem</h2>
        <p class="mb-4 text-sm text-blue-100/60">Udostępnij ten link, aby zaprosić kogoś do tej grupy.</p>
        <input
          type="text"
          readonly
          value={inviteLink}
          class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white"
          onclick="this.select()"
        />
      </div>

      <div class="mb-8 rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h2 class="mb-4 text-lg font-semibold">Członkowie</h2>
        <ul class="space-y-2">
          {
            group.members.map((member) => (
              <li class="rounded-lg border border-white/10 bg-white/5 px-4 py-3">
                <span class="font-medium text-white">{member.email}</span>
                <span class="ml-2 text-sm text-blue-100/50">
                  dołączenie: {new Date(member.joinedAt).toLocaleDateString()}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mb-8 rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h2 class="mb-4 text-lg font-semibold">Cele członków grupy</h2>
        {
          otherMembers.length === 0 ? (
            <p class="text-sm text-blue-100/60">Nie masz jeszcze innych członków w tej grupie.</p>
          ) : (
            <div class="space-y-6">
              {otherMembers.map((member) => {
                const memberGoals = goalsByMember.get(member.userId) ?? [];
                return (
                  <div>
                    <h3 class="mb-2 text-sm font-semibold text-blue-100/80">{member.email}</h3>
                    {memberGoals.length === 0 ? (
                      <p class="text-sm text-blue-100/50">Brak celów.</p>
                    ) : (
                      <div class="space-y-3">
                        {memberGoals.map((goal) => (
                          <GoalCard client:load goal={goal} editable={false} remainingLabel={null} readOnly={true} />
                        ))}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          )
        }
      </div>

      <form method="POST" action="/api/groups/leave">
        <input type="hidden" name="groupId" value={group.id} />
        <button type="submit" class="text-sm text-red-300 transition-colors hover:text-red-200 hover:underline">
          Opuść grupę
        </button>
      </form>
    </div>
  </div>
</Layout>
