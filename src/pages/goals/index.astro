---
import Layout from "@/layouts/Layout.astro";
import GoalBundleForm from "@/components/goals/GoalBundleForm";
import GoalCard from "@/components/goals/GoalCard";
import { createClient } from "@/lib/supabase";
import { editWindowRemainingMs, isEditable, listGoals } from "@/lib/services/goals";
import type { Goal } from "@/types";

const user = Astro.locals.user;
const error = Astro.url.searchParams.get("error");
const created = Astro.url.searchParams.get("created") === "1";
const progressSaved = Astro.url.searchParams.get("progress") === "1";
const updated = Astro.url.searchParams.get("updated") === "1";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const goals: Goal[] = supabase && user ? await listGoals(supabase, user.id) : [];

/** Editable-first; within editable, least-time-remaining (oldest) first — those are closest to
 * locking. Within locked, newest-first (listGoals's natural order). */
const sorted = [...goals].sort((a, b) => {
  const aEditable = isEditable(a);
  const bEditable = isEditable(b);
  if (aEditable !== bEditable) {
    return aEditable ? -1 : 1;
  }
  const aCreated = new Date(a.createdAt).getTime();
  const bCreated = new Date(b.createdAt).getTime();
  return aEditable ? aCreated - bCreated : bCreated - aCreated;
});

function formatRemaining(ms: number): string {
  const totalMinutes = Math.max(0, Math.round(ms / 60000));
  const hours = Math.floor(totalMinutes / 60);
  const minutes = totalMinutes % 60;
  return hours === 0 ? `Do edycji: jeszcze ${minutes} min` : `Do edycji: jeszcze ${hours}h ${minutes}min`;
}
---

<Layout title="Moje cele">
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-2xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Moje cele
      </h1>

      {
        created && (
          <div class="mb-6 rounded-lg border border-emerald-400/30 bg-emerald-900/20 px-4 py-3 text-sm text-emerald-200">
            Cele zapisane! Blokują się po 24 godzinach — do tego czasu możesz je edytować lub usunąć poniżej.
          </div>
        )
      }

      {
        progressSaved && (
          <div class="mb-6 rounded-lg border border-emerald-400/30 bg-emerald-900/20 px-4 py-3 text-sm text-emerald-200">
            Postęp zapisany.
          </div>
        )
      }

      {
        updated && (
          <div class="mb-6 rounded-lg border border-emerald-400/30 bg-emerald-900/20 px-4 py-3 text-sm text-emerald-200">
            Zmiany zapisane.
          </div>
        )
      }

      {
        error && (
          <div class="mb-6 rounded-lg border border-red-500/30 bg-red-900/30 px-4 py-3 text-sm text-red-300">
            {error}
          </div>
        )
      }

      <div class="mb-8 rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h2 class="mb-4 text-lg font-semibold">Dodaj nowe cele</h2>
        <GoalBundleForm serverError={error} client:load />
      </div>

      {goals.length === 0 && <p class="text-blue-100/60">Nie masz jeszcze żadnych celów. Dodaj pierwszy powyżej.</p>}

      {
        goals.length > 0 && (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
            <h2 class="mb-4 text-lg font-semibold">Lista celów</h2>
            <div class="flex flex-col gap-4">
              {sorted.map((goal) => {
                const editable = isEditable(goal);
                const remainingLabel = editable ? formatRemaining(editWindowRemainingMs(goal)) : null;
                return (
                  <div>
                    <GoalCard goal={goal} editable={editable} remainingLabel={remainingLabel} client:load />
                  </div>
                );
              })}
            </div>
          </div>
        )
      }
    </div>
  </div>
</Layout>
